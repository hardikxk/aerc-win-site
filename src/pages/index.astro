---
// aerc-win - minimalist native Windows email client landing page
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>aerc-win - a pretty good email client for Windows</title>
		<meta name="description" content="Native Windows port of aerc, the fast, keyboard-driven terminal email client." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
	</head>
	<body>
		<header class="hero-header">
			<div class="header-inner">
				<h1 class="logo">aerc-win</h1>
				<p class="tagline">a pretty good email client for <u>Windows</u></p>
				<nav class="nav-links">
					<a href="https://github.com/hardikxk/aerc-win" target="_blank" rel="noopener">source code &rarr;</a>
					<a href="https://github.com/hardikxk/aerc-win/releases" target="_blank" rel="noopener">releases &rarr;</a>
					<a href="https://github.com/hardikxk/aerc-win/discussions" target="_blank" rel="noopener">discussions &rarr;</a>
					<a href="https://github.com/hardikxk/aerc-win/issues" target="_blank" rel="noopener">bug tracker &rarr;</a>
					<a href="https://aerc-mail.org/" target="_blank" rel="noopener">original aerc &rarr;</a>
					<a href="https://git.sr.ht/~rjarry/aerc" target="_blank" rel="noopener">upstream source &rarr;</a>
				</nav>
			</div>
		</header>

		<main class="main-content">
			<!-- Quick Install Box -->
			<section class="install-section">
				<div class="install-card">
					<div class="install-header">
						<span class="install-badge">Quick Install</span>
						<span class="install-sub">PowerShell</span>
					</div>
					<div class="command-box">
						<code id="install-cmd">irm https://raw.githubusercontent.com/hardikxk/aerc-win/master/install.ps1 | iex</code>
						<button id="copy-btn" class="copy-button" title="Copy to clipboard" aria-label="Copy install command">
							<svg class="copy-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
								<rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
								<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
							</svg>
							<span class="btn-text">Copy</span>
						</button>
					</div>
				</div>
			</section>

			<!-- Screenshot Showcase -->
			<section class="media-container">
				<div class="media-window">
					<div class="window-bar">
						<span class="window-dot dot-red"></span>
						<span class="window-dot dot-yellow"></span>
						<span class="window-dot dot-green"></span>
						<span class="window-title">Windows Terminal &mdash; aerc</span>
					</div>
					<img src="/aerc_ss.png" alt="aerc terminal email client running natively on Windows" class="showcase-img" />
				</div>
			</section>

			<!-- Information Card -->
			<section class="card-section">
				<article class="info-card">
					<h2>A pretty good email client, natively on Windows</h2>
					<p class="lead">
						<strong>aerc-win</strong> brings native Windows support to <a href="https://sr.ht/~rjarry/aerc/">aerc</a>
					</p>

					<p>
						Runs seamlessly in Windows Terminal and PowerShell with zero dependencies on WSL or Cygwin.
					</p>

					<h3>Key Features</h3>
					<ul class="feature-list">
						<li><strong>Native Windows Runtime:</strong> Fully compiled Go binary with Windows console and VT sequence management.</li>
						<li><strong>Everything else offered by aerc.</strong> </li>
					</ul>

					<div class="credits">
						<p>
							Forked and ported to Windows by <a href="https://github.com/hardikxk">Hardik Kumar</a>. Based on upstream work by <a href="https://git.sr.ht/~rjarry/aerc">Robin Jarry</a> and <a href="https://git.sr.ht/~sircmpwn/aerc">Drew DeVault</a>. Licensed under the MIT License.
						</p>
					</div>
				</article>
			</section>
		</main>

		<footer class="site-footer">
			<p>
				<a href="https://github.com/hardikxk/aerc-win">GitHub</a> &bull; 
				<a href="https://github.com/hardikxk/aerc-win/releases">Releases</a> &bull; 
				<a href="https://aerc-mail.org/">aerc-mail.org</a>
			</p>
		</footer>

		<script>
			const copyBtn = document.getElementById('copy-btn');
			const installCmd = document.getElementById('install-cmd');

			if (copyBtn && installCmd) {
				copyBtn.addEventListener('click', async () => {
					try {
						await navigator.clipboard.writeText(installCmd.innerText.trim());
						const originalText = copyBtn.querySelector('.btn-text');
						if (originalText) {
							originalText.textContent = 'Copied!';
							copyBtn.classList.add('copied');
							setTimeout(() => {
								originalText.textContent = 'Copy';
								copyBtn.classList.remove('copied');
							}, 2000);
						}
					} catch (err) {
						console.error('Failed to copy command', err);
					}
				});
			}
		</script>
	</body>
</html>

<style>
	:root {
		--bg-outer: #1c1c1c;
		--bg-pattern: #222222;
		--bg-card: #fdfdfd;
		--text-dark: #222222;
		--text-muted: #555555;
		--primary-link: #0066cc;
		--primary-link-hover: #004499;
		--code-bg: #1e1e1e;
		--code-text: #e0e0e0;
		--terminal-border: #333333;
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	body {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
		background-color: var(--bg-outer);
		background-image: 
			radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 0),
			radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 0);
		background-size: 24px 24px;
		background-position: 0 0, 12px 12px;
		color: #e0e0e0;
		line-height: 1.6;
		padding: 2.5rem 1rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		min-height: 100vh;
	}

	/* Header */
	.hero-header {
		text-align: center;
		margin-bottom: 2rem;
		max-width: 900px;
		width: 100%;
	}

	.logo {
		font-family: 'Fira Code', monospace;
		font-size: 2.75rem;
		font-weight: 600;
		color: #ffffff;
		letter-spacing: -0.04em;
		margin-bottom: 0.25rem;
	}

	.tagline {
		font-size: 1.15rem;
		color: #aaaaaa;
		margin-bottom: 1.25rem;
	}

	.nav-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.85rem 1.4rem;
		font-size: 0.95rem;
	}

	.nav-links a {
		color: #4da3ff;
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color 0.15s ease;
	}

	.nav-links a:hover {
		color: #80c0ff;
	}

	/* Main */
	.main-content {
		max-width: 980px;
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	/* Install Section */
	.install-section {
		width: 100%;
	}

	.install-card {
		background: #141414;
		border: 1px solid #333333;
		border-radius: 8px;
		padding: 1.25rem 1.5rem;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
	}

	.install-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.75rem;
	}

	.install-badge {
		font-family: 'Fira Code', monospace;
		font-size: 0.85rem;
		font-weight: 500;
		color: #e0e0e0;
		letter-spacing: 0.02em;
	}

	.install-sub {
		font-size: 0.85rem;
		color: #888888;
	}

	.command-box {
		display: flex;
		align-items: center;
		background: #000000;
		border: 1px solid #2a2a2a;
		border-radius: 6px;
		padding: 0.75rem 1rem;
		gap: 0.75rem;
		overflow-x: auto;
	}

	.command-box code {
		font-family: 'Fira Code', monospace;
		font-size: 0.95rem;
		color: #22c55e;
		white-space: nowrap;
		flex: 1;
	}

	.copy-button {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		background: #222222;
		color: #ffffff;
		border: 1px solid #444444;
		border-radius: 4px;
		padding: 0.4rem 0.8rem;
		font-size: 0.85rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.15s ease;
		flex-shrink: 0;
	}

	.copy-button:hover {
		background: #333333;
		border-color: #666666;
	}

	.copy-button.copied {
		background: #15803d;
		border-color: #22c55e;
	}

	/* Screenshot Showcase */
	.media-container {
		width: 100%;
	}

	.media-window {
		background: #000000;
		border: 1px solid var(--terminal-border);
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
	}

	.window-bar {
		background: #181818;
		border-bottom: 1px solid #282828;
		padding: 0.6rem 1rem;
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.window-dot {
		width: 11px;
		height: 11px;
		border-radius: 50%;
	}

	.dot-red { background: #ff5f56; }
	.dot-yellow { background: #ffbd2e; }
	.dot-green { background: #27c93f; }

	.window-title {
		margin-left: 0.5rem;
		font-size: 0.8rem;
		font-family: 'Fira Code', monospace;
		color: #777777;
	}

	.showcase-img {
		display: block;
		width: 100%;
		height: auto;
		image-rendering: -webkit-optimize-contrast;
	}

	/* Info Card */
	.card-section {
		width: 100%;
	}

	.info-card {
		background: var(--bg-card);
		color: var(--text-dark);
		border-radius: 8px;
		padding: 2.5rem;
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
	}

	.info-card h2 {
		font-size: 1.6rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		margin-bottom: 1rem;
		color: #111111;
	}

	.info-card .lead {
		font-size: 1.05rem;
		line-height: 1.6;
		margin-bottom: 1rem;
		color: #222222;
	}

	.info-card p {
		margin-bottom: 1.25rem;
		color: #333333;
	}

	.info-card h3 {
		font-size: 1.15rem;
		font-weight: 600;
		margin-top: 1.5rem;
		margin-bottom: 0.75rem;
		color: #111111;
	}

	.feature-list {
		list-style: disc;
		padding-left: 1.5rem;
		margin-bottom: 1.75rem;
	}

	.feature-list li {
		margin-bottom: 0.5rem;
		color: #333333;
	}

	.feature-list li strong {
		color: #111111;
	}

	.info-card a {
		color: var(--primary-link);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.info-card a:hover {
		color: var(--primary-link-hover);
	}

	.info-card code {
		font-family: 'Fira Code', monospace;
		background: #ededed;
		color: #b91c1c;
		padding: 0.15rem 0.35rem;
		border-radius: 3px;
		font-size: 0.88em;
	}

	.credits {
		border-top: 1px solid #e5e5e5;
		padding-top: 1.25rem;
		margin-top: 1.5rem;
		font-size: 0.88rem;
		color: #666666;
	}

	.credits p {
		margin-bottom: 0;
	}

	/* Footer */
	.site-footer {
		margin-top: 2.5rem;
		text-align: center;
		font-size: 0.9rem;
		color: #777777;
	}

	.site-footer a {
		color: #888888;
		text-decoration: none;
		margin: 0 0.3rem;
	}

	.site-footer a:hover {
		color: #ffffff;
		text-decoration: underline;
	}

	@media (max-width: 640px) {
		body {
			padding: 1.5rem 0.75rem;
		}

		.logo {
			font-size: 2.1rem;
		}

		.info-card {
			padding: 1.5rem;
		}

		.command-box {
			flex-direction: column;
			align-items: stretch;
		}

		.copy-button {
			justify-content: center;
		}
	}
</style>
